  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile and coin wallet"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "CoinTransaction",
      "description": "User coin transaction history"
    },
    "/users/{userId}/dailyManager/{docId}": {
      "schema": "UserDailyManager",
      "description": "User personal Daily Hishab, To-Do list, notes, and habits ledger"
    },
    "/users/{userId}/cvProfile/{profileId}": {
      "schema": "UserCVProfile",
      "description": "User reusable Job CV Helper profile isolated per user"
    },
    "/users/{userId}/savedCvs/{cvId}": {
      "schema": "UserSavedCV",
      "description": "Private job-specific CVs saved in the user's CV library"
    },
    "/depositRequests/{requestId}": {
      "schema": "DepositRequest",
      "description": "bKash add money payment verification requests"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Protected server-controlled administrator registry"
    },
    "/settings/{settingId}": {
      "description": "Public system configurations (paymentMode, developerContact, notices)"
    },
    "/shops/{shopId}": {
      "schema": "ShopProfile",
      "description": "Isolated My Digital Shop Management profile per shop account"
    },
    "/shops/{shopId}/assets/{assetId}": {
      "schema": "ShopAsset",
      "description": "Shop logo, visiting card, and signature assets isolated per shop"
    },
    "/shops/{shopId}/products/{productId}": {
      "schema": "ShopProduct",
      "description": "Shop products and inventory items with category-specific fields"
    },
    "/shops/{shopId}/invoices/{invoiceId}": {
      "schema": "ShopInvoice",
      "description": "Shop Cash Memos and Invoices isolated per shop"
    },
    "/shops/{shopId}/receipts/{receiptId}": {
      "schema": "ShopReceipt",
      "description": "Shop Money Receipts isolated per shop"
    },
    "/shops/{shopId}/customers/{customerId}": {
      "schema": "ShopCustomer",
      "description": "Shop customers and due balances isolated per shop"
