{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with registered email/phone and coin wallet balance",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique user ID matching Auth UID"
        },
        "displayName": {
          "type": "string",
          "description": "Full display name"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "phoneNumber": {
          "type": "string",
          "description": "User mobile phone number"
        },
        "photoURL": {
          "type": "string",
          "description": "User avatar image URL"
        },
        "balance": {
          "type": "number",
          "description": "Current main cash balance in BDT"
        },
        "coins": {
          "type": "number",
          "description": "Current active coin wallet balance"
        },
        "totalEarnedCoins": {
          "type": "number",
          "description": "Cumulative coins earned"
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended", "banned"],
          "description": "User account status (active, suspended, or banned)"
        },
        "banReason": {
          "type": "string",
          "description": "Reason for suspension or ban"
        },
        "suspendedUntil": {
          "type": "string",
          "description": "ISO timestamp until which user account is suspended"
        },
        "lastSpinDate": {
          "type": "string",
          "description": "Date of latest daily spin in YYYY-MM-DD"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "user"],
          "description": "User access role"
        },
        "createdAt": {
          "type": "string",
          "description": "Account creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["userId", "coins"]
    },
    "CoinTransaction": {
      "title": "CoinTransaction",
      "description": "Ledger of coin credits earned from spins or rewards",
      "type": "object",
      "properties": {
        "transactionId": {
          "type": "string",
          "description": "Unique transaction ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID"
        },
        "amount": {
          "type": "number",
          "description": "Coins added"
        },
        "type": {
          "type": "string",
          "description": "Transaction category"
        },
        "description": {
          "type": "string",
          "description": "Transaction note in Bangla"
        },
        "date": {
          "type": "string",
          "description": "Date in YYYY-MM-DD"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp"
        }
      },
      "required": ["transactionId", "userId", "amount", "type"]
    },
    "DepositRequest": {
      "title": "DepositRequest",
      "description": "User bKash Add Money verification requests with TrxID",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhone": { "type": "string" },
        "amount": { "type": "number", "description": "Cash amount in BDT" },
        "trxId": { "type": "string", "description": "bKash transaction ID" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "adminNote": { "type": "string" },
        "createdAt": { "type": "string" },
        "reviewedAt": { "type": "string" }
      },
      "required": ["id", "userId", "amount", "trxId", "status"]
    },
    "UserDailyManager": {
      "title": "UserDailyManager",
      "description": "User personal daily financial transactions, todo tasks, memos and habits synced to their account",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner user UID" },
        "transactions": { "type": "array", "description": "Financial income and expense records" },
        "tasks": { "type": "array", "description": "To-do items and daily tasks" },
        "notes": { "type": "array", "description": "Daily notes and memos" },
        "habits": { "type": "object", "description": "Daily habit tracker checkmarks" },
        "debts": { "type": "array", "description": "Dena-Paona / Loan records" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last cloud sync" }
      },
      "required": ["userId", "updatedAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrator document providing server-controlled admin privileges",
      "type": "object",
      "properties": {
        "adminId": { "type": "string", "description": "Admin user UID" },
        "email": { "type": "string", "description": "Admin email" },
        "role": { "type": "string", "enum": ["admin"], "description": "Admin privilege role" },
        "grantedBy": { "type": "string", "description": "UID of administrator who granted access" },
        "createdAt": { "type": "string", "description": "Grant timestamp" }
      },
      "required": ["adminId", "role"]
    },
    "ShopProfile": {
      "title": "ShopProfile",
      "description": "Independent My Digital Shop Management tenant profile owned by an isolated shop Auth UID",
      "type": "object",
      "properties": {
        "shopId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "shopCategory": {
          "type": "string",
          "enum": [
            "mobile-shop",
            "computer-laptop",
            "electronics",
            "general-store",
            "grocery",
            "clothing-fashion",
            "cosmetics-beauty",
            "pharmacy",
            "stationery-book",
            "gift-accessories",
            "hardware-building",
            "other-shop"
          ]
        },
        "shopName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "tagline": { "type": "string", "maxLength": 240 },
        "subtitle": { "type": "string", "maxLength": 180 },
        "ownerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 5, "maxLength": 30 },
        "email": { "type": "string", "maxLength": 180 },
        "website": { "type": "string", "maxLength": 200 },
        "address": { "type": "string", "maxLength": 400 },
        "tradeLicense": { "type": "string", "maxLength": 100 },
        "binVatNumber": { "type": "string", "maxLength": 100 },
        "bkashNumber": { "type": "string", "maxLength": 60 },
        "nagadNumber": { "type": "string", "maxLength": 60 },
        "rocketNumber": { "type": "string", "maxLength": 60 },
        "bankName": { "type": "string", "maxLength": 120 },
        "bankAccountName": { "type": "string", "maxLength": 120 },
        "bankAccountNumber": { "type": "string", "maxLength": 80 },
        "brandColor": { "type": "string", "maxLength": 24 },
        "language": { "type": "string", "enum": ["bn", "en"] },
        "defaultTemplate": { "type": "string", "maxLength": 60 },
        "defaultInvoiceFooter": { "type": "string", "maxLength": 300 },
        "religiousHeader": { "type": "string", "maxLength": 120 },
        "signatureTitle": { "type": "string", "maxLength": 100 },
        "authType": { "type": "string", "enum": ["phone", "email"] },
        "loginIdentifier": { "type": "string", "maxLength": 180 },
        "hasLogo": { "type": "boolean" },
        "hasVisitingCard": { "type": "boolean" },
        "visitingCardMode": { "type": "string", "enum": ["none", "uploaded", "created"] },
        "visitingCardTemplate": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 60 },
        "updatedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["shopId", "ownerUid", "shopCategory", "shopName", "ownerName", "phone", "createdAt", "updatedAt"]
    },
    "ShopAsset": {
      "title": "ShopAsset",
      "description": "Compressed branding media asset (logo, visiting card, or signature) isolated per shop",
      "type": "object",
      "properties": {
        "assetId": { "type": "string", "enum": ["branding_logo", "branding_card", "branding_sig"] },
        "shopId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "assetType": { "type": "string", "enum": ["logo", "visiting_card", "signature"] },
        "mimeType": { "type": "string", "maxLength": 60 },
        "dataUrl": { "type": "string", "maxLength": 650000 },
        "updatedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["assetId", "shopId", "ownerUid", "assetType", "dataUrl", "updatedAt"]
    },
    "ShopProduct": {
      "title": "ShopProduct",
      "description": "Shop inventory product with category-specific custom fields",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "shopId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 180 },
        "sku": { "type": "string", "maxLength": 80 },
        "category": { "type": "string", "maxLength": 100 },
        "brand": { "type": "string", "maxLength": 100 },
        "model": { "type": "string", "maxLength": 120 },
        "unit": { "type": "string", "maxLength": 40 },
        "purchasePrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "stock": { "type": "number" },
        "minStockAlert": { "type": "number" },
        "warranty": { "type": "string", "maxLength": 80 },
        "expiryDate": { "type": "string", "maxLength": 30 },
        "batchNumber": { "type": "string", "maxLength": 80 },
        "customFields": { "type": "object" },
        "notes": { "type": "string", "maxLength": 500 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 60 },
        "updatedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "shopId", "ownerUid", "name", "sellingPrice", "stock", "createdAt", "updatedAt"]
    },
    "ShopInvoice": {
      "title": "ShopInvoice",
      "description": "Shop Cash Memo / Invoice persisted per shop",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "shopId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "invoiceNumber": { "type": "string", "minLength": 1, "maxLength": 60 },
        "invoiceDate": { "type": "string", "maxLength": 30 },
        "dueDate": { "type": "string", "maxLength": 30 },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "partial", "paid", "overdue"] },
        "currency": { "type": "string", "maxLength": 24 },
        "language": { "type": "string", "enum": ["bn", "en"] },
        "template": { "type": "string", "maxLength": 60 },
        "customer": { "type": "object" },
        "items": { "type": "array" },
        "invoiceDiscountType": { "type": "string", "enum": ["fixed", "percent"] },
        "invoiceDiscountValue": { "type": "number" },
        "shippingCharge": { "type": "number" },
        "paidAmount": { "type": "number" },
        "notes": { "type": "string", "maxLength": 1000 },
        "terms": { "type": "string", "maxLength": 1000 },
        "signatureTitle": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "maxLength": 60 },
        "updatedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "shopId", "ownerUid", "invoiceNumber", "items", "createdAt", "updatedAt"]
    },
    "ShopReceipt": {
      "title": "ShopReceipt",
      "description": "Shop Money Receipt persisted per shop",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "shopId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "receiptNumber": { "type": "string", "minLength": 1, "maxLength": 60 },
        "receiptDate": { "type": "string", "maxLength": 30 },
        "receivedFrom": { "type": "string", "maxLength": 160 },
        "customerPhone": { "type": "string", "maxLength": 40 },
        "amount": { "type": "number" },
        "amountInWords": { "type": "string", "maxLength": 300 },
        "paymentMethod": { "type": "string", "enum": ["cash", "bkash", "nagad", "rocket", "bank", "card", "other"] },
        "paymentPurpose": { "type": "string", "maxLength": 300 },
        "relatedInvoiceNumber": { "type": "string", "maxLength": 60 },
        "receivedBy": { "type": "string", "maxLength": 120 },
        "notes": { "type": "string", "maxLength": 600 },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "shopId", "ownerUid", "receiptNumber", "amount", "createdAt"]
    },
    "ShopCustomer": {
      "title": "ShopCustomer",
