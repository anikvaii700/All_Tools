        "notes": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "maxLength": 60 },
        "updatedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "shopId", "ownerUid", "name", "createdAt", "updatedAt"]
    },
    "ShopExpense": {
      "title": "ShopExpense",
      "description": "Shop operating expense entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "shopId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "category": { "type": "string", "maxLength": 80 },
        "amount": { "type": "number" },
        "date": { "type": "string", "maxLength": 30 },
        "paymentMethod": { "type": "string", "maxLength": 30 },
        "note": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "maxLength": 60 },
        "updatedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "shopId", "ownerUid", "title", "amount", "date", "createdAt", "updatedAt"]
    },
    "ShopRepair": {
      "title": "ShopRepair",
      "description": "Device servicing and repair ticket for Mobile, Computer, and Electronics shops",
