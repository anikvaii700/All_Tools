        "receivedDate": { "type": "string", "maxLength": 30 },
        "deliveryDate": { "type": "string", "maxLength": 30 },
        "notes": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "maxLength": 60 },
        "updatedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "shopId", "ownerUid", "ticketNumber", "customerName", "deviceName", "status", "createdAt", "updatedAt"]
