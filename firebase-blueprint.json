{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with registered email/phone and coin wallet balance",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique user ID matching Auth UID"
        },
        "displayName": {
          "type": "string",
          "description": "Full display name"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "phoneNumber": {
          "type": "string",
          "description": "User mobile phone number"
        },
        "photoURL": {
          "type": "string",
          "description": "User avatar image URL"
        },
        "balance": {
          "type": "number",
          "description": "Current main cash balance in BDT"
        },
        "coins": {
          "type": "number",
          "description": "Current active coin wallet balance"
        },
        "totalEarnedCoins": {
          "type": "number",
          "description": "Cumulative coins earned"
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended", "banned"],
          "description": "User account status (active, suspended, or banned)"
        },
        "banReason": {
          "type": "string",
          "description": "Reason for suspension or ban"
        },
        "suspendedUntil": {
          "type": "string",
          "description": "ISO timestamp until which user account is suspended"
        },
        "lastSpinDate": {
          "type": "string",
          "description": "Date of latest daily spin in YYYY-MM-DD"
        },
        "createdAt": {
          "type": "string",
          "description": "Account creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["userId", "coins"]
    },
    "CoinTransaction": {
      "title": "CoinTransaction",
      "description": "Ledger of coin credits earned from spins or rewards",
      "type": "object",
      "properties": {
        "transactionId": {
          "type": "string",
          "description": "Unique transaction ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID"
        },
        "amount": {
          "type": "number",
          "description": "Coins added"
        },
        "type": {
          "type": "string",
          "description": "Transaction category"
        },
        "description": {
          "type": "string",
          "description": "Transaction note in Bangla"
        },
        "date": {
          "type": "string",
          "description": "Date in YYYY-MM-DD"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp"
        }
      },
      "required": ["transactionId", "userId", "amount", "type"]
    },
    "DepositRequest": {
      "title": "DepositRequest",
      "description": "User bKash Add Money verification requests with TrxID",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhone": { "type": "string" },
        "amount": { "type": "number", "description": "Cash amount in BDT" },
        "trxId": { "type": "string", "description": "bKash transaction ID" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "adminNote": { "type": "string" },
        "createdAt": { "type": "string" },
        "reviewedAt": { "type": "string" }
      },
      "required": ["id", "userId", "amount", "trxId", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile and coin wallet"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "CoinTransaction",
      "description": "User coin transaction history"
    },
    "/depositRequests/{requestId}": {
      "schema": "DepositRequest",
      "description": "bKash add money payment verification requests"
    },
    "/settings/{settingId}": {
      "description": "Public system configurations (paymentMode, developerContact, notices)"
    }
  }
}
