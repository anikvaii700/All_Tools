rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User profile & Coin Wallet
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isOwner(userId) && isValidId(userId)
        && request.resource.data.userId == userId
        && request.resource.data.coins is number
        && request.resource.data.coins >= 0
        && request.resource.data.coins <= 1000000;

      allow update: if isOwner(userId) && isValidId(userId)
        && request.resource.data.userId == userId
        && request.resource.data.coins is number
        && request.resource.data.coins >= 0
        && request.resource.data.coins <= 1000000;

      allow delete: if false;

      // Subcollection: Coin Transactions ledger
      match /transactions/{transactionId} {
        allow read: if isOwner(userId) && isValidId(userId) && isValidId(transactionId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(transactionId)
          && request.resource.data.userId == userId
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 1000;
        allow update, delete: if false;
      }
    }

    // Public System Settings (Developer Contact & Photo)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
