rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User profile & Coin Wallet
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;

      // Subcollection: Coin Transactions ledger
      match /transactions/{transactionId} {
        allow read, create: if true;
        allow update, delete: if false;
      }
    }

    // Public System Settings (Developer Contact & Photo)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Deposit / Add Money Verification Requests (bKash TrxID verification)
    match /depositRequests/{requestId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
  }
}
